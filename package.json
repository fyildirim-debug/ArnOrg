{
  "name": "arnorg",
  "private": true,
  "version": "0.0.9",
  "description": "Claude Code ajanlarından kurulan yazılım şirketi: proje, ekip, planlama, canlı denetim ve kod editörü",
  "keywords": [
    "claude-code",
    "claude",
    "claude-ai",
    "anthropic",
    "claude-agent-sdk",
    "ai-agents",
    "multi-agent",
    "autonomous-agents",
    "agentic-ai",
    "agent-orchestration",
    "coding-agent",
    "ai-coding",
    "llm-agents",
    "llm",
    "developer-tools",
    "software-engineering",
    "electron",
    "desktop-app",
    "typescript",
    "yapay-zeka"
  ],
  "homepage": "https://github.com/fyildirim-debug/ArnOrg#readme",
  "bugs": {
    "url": "https://github.com/fyildirim-debug/ArnOrg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyildirim-debug/ArnOrg.git"
  },
  "license": "MIT",
  "author": {
    "name": "Furkan YILDIRIM",
    "email": "posta@furkanyildirim.com"
  },
  "type": "module",
  "workspaces": [
    "paketler/ortak",
    "paketler/cekirdek",
    "paketler/studyo",
    "paketler/masaustu"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @arnorg/cekirdek",
    "dev:studyo": "npm run dev -w @arnorg/studyo",
    "build": "npm run build -w @arnorg/studyo && npm run build -w @arnorg/cekirdek",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "serve": "node paketler/cekirdek/dist/cli.js serve",
    "masaustu": "npm run start -w @arnorg/masaustu",
    "paketle": "npm run build && npm run paketle -w @arnorg/masaustu",
    "surum": "node betikler/surum.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
